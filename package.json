{
  "name": "kimi-web-tools",
  "version": "0.4.0",
  "description": "Minimal 9Router web search and optional fetch gateway for Kimi Code",
  "type": "module",
  "license": "MIT",
  "keywords": ["web-search", "web-fetch", "9router", "agy-search", "mcp"],
  "main": "./lib/host/gateway-server.js",
  "exports": {
    ".": "./lib/host/gateway-server.js",
    "./gateway": "./lib/host/gateway-server.js"
  },
  "bin": {
    "kimi-web-tools-gateway": "./bin/gateway-daemon.mjs",
    "kimi-web-tools-mcp": "./bin/mcp-server.mjs"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test test/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "typescript": "^5.8.2"
  }
}
