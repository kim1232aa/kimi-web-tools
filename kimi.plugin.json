{
  "name": "kimi-web-tools",
  "version": "0.4.0",
  "description": "Minimal 9Router web search and optional web fetch for Kimi Code",
  "keywords": [
    "web-search",
    "web-fetch",
    "9router",
    "mcp"
  ],
  "license": "MIT",
  "skills": "./skills/",
  "systemPromptPath": "./SYSTEM.md",
  "mcpServers": {
    "web": {
      "command": "/usr/bin/node",
      "args": ["./bin/mcp-server.mjs"],
      "cwd": "./",
      "toolTimeoutMs": 120000
    }
  },
  "hooks": [
    {
      "event": "UserPromptSubmit",
      "command": "/usr/bin/node ./hooks/user-prompt-submit.mjs",
      "timeout": 10
    },
    {
      "event": "PreToolUse",
      "matcher": "^(FetchURL|web_search|web_fetch|.*__(web_search|web_fetch|search_web|tavily_search))$",
      "command": "/usr/bin/node ./hooks/pre-tool-gate.mjs",
      "timeout": 10
    },
    {
      "event": "Stop",
      "command": "/usr/bin/node ./hooks/stop-turn-gate.mjs",
      "timeout": 10
    }
  ],
  "interface": {
    "displayName": "Kimi Web Tools",
    "shortDescription": "Minimal 9Router web search and optional fetch gateway",
    "developerName": "kimi-web-tools"
  }
}
